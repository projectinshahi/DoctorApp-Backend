// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String?
  phone     String?
  avatarUrl String?
  role      String   @default("student")
  status    String   @default("unverified")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]

  selectedCourseId     Int?
  selectedCourseTypeId Int?
  selectedCourse       Course?     @relation(fields: [selectedCourseId], references: [id])
  selectedCourseType   CourseType? @relation(fields: [selectedCourseTypeId], references: [id])

  @@map("users")
}


model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]

  @@map("admins")
}


model Subject {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics  Topic[]
  courses Course[]

  @@map("subjects")
}

model Topic {
  id        Int      @id @default(autoincrement())
  name      String
  subjectId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([subjectId])
  @@map("topics")
}

model Session {
  id           Int       @id @default(autoincrement())
  userId       Int
  deviceId     String
  refreshToken String    @unique
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}


enum CourseStatus {
  draft
  published
  archived
}

enum AccessType {
  free
  premium
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  thumbnail    String?
  classGrade   String?
  difficulty   String?
  status       CourseStatus @default(draft)
  accessType   AccessType   @default(free)
  displayOrder Int          @default(0)
  createdBy    Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subjects    Subject[]
  admin       Admin?       @relation(fields: [createdBy], references: [id])
  chapters    Chapter[]
  courseTypes CourseType[]
  selectedBy  User[]

  @@index([createdBy])
  @@map("courses")
}

model CourseType {
  id           Int          @id @default(autoincrement())
  courseId     Int
  title        String
  description  String?
  status       CourseStatus @default(draft)
  accessType   AccessType   @default(free)
  displayOrder Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters   Chapter[]
  selectedBy User[]

  @@index([courseId])
  @@map("course_types")
}


model Chapter {
  id           Int      @id @default(autoincrement())
  courseId     Int?                       // nullable now
  courseTypeId Int?                       // NEW: nullable
  title        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseType CourseType? @relation(fields: [courseTypeId], references: [id], onDelete: Cascade)
  lessons    Lesson[]

  @@index([courseId])
  @@index([courseTypeId])
  @@map("chapters")
}

enum LessonType {
  video
  text
  quiz
}

model Lesson {
  id            Int        @id @default(autoincrement())
  chapterId     Int
  title         String
  type          LessonType
  content       String?    // video URL, text/notes content, or quiz reference
  displayOrder  Int        @default(0)
  isFreePreview Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("lessons")
}