// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String?
  phone     String?
  avatarUrl String?
  role      String   @default("student")
  status    String   @default("unverified")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  subscriptions  Subscription[]
  quizAttempts   QuizAttempt[]
  savedQuestions SavedQuestion[]
  savedLessons   SavedLesson[]
  lessonProgress LessonProgress[]

  selectedCourseId     Int?
  selectedCourseTypeId Int?
  selectedCourse       Course?     @relation(fields: [selectedCourseId], references: [id])
  selectedCourseType   CourseType? @relation(fields: [selectedCourseTypeId], references: [id])

  @@map("users")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@map("admins")
}

model Subject {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topics    Topic[]
  courses   Course[]
  questions Question[]
  quizzes   Quiz[]

  @@map("subjects")
}

model Topic {
  id           Int      @id @default(autoincrement())
  name         String
  subjectId    Int
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id])
  questions Question[]
  quizzes   Quiz[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@map("topics")
}

model Session {
  id           Int       @id @default(autoincrement())
  userId       Int
  deviceId     String
  refreshToken String    @unique
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

enum CourseStatus {
  draft
  published
  archived
}

enum AccessType {
  free
  premium
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  thumbnail    String?
  classGrade   String?
  difficulty   String?
  status       CourseStatus @default(draft)
  accessType   AccessType   @default(free)
  displayOrder Int          @default(0)
  createdBy    Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subjects      Subject[]
  admin         Admin?         @relation(fields: [createdBy], references: [id])
  chapters      Chapter[]
  courseTypes   CourseType[]
  selectedBy    User[]
  plans         Plan[]
  subscriptions Subscription[]

  @@index([createdBy])
  @@map("courses")
}

model CourseType {
  id           Int          @id @default(autoincrement())
  courseId     Int
  title        String
  description  String?
  status       CourseStatus @default(draft)
  accessType   AccessType   @default(free)
  // Non-null with a default, same as Chapter/Lesson/Subject. Nulls here are
  // meaningless for ordering and three separate writers used to produce them.
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters   Chapter[]
  selectedBy User[]

  @@index([courseId])
  @@map("course_types")
}

model Chapter {
  id           Int      @id @default(autoincrement())
  courseId     Int? // nulRlable now
  courseTypeId Int? // NEW: nullable
  title        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseType CourseType? @relation(fields: [courseTypeId], references: [id], onDelete: Cascade)
  lessons    Lesson[]

  @@index([courseId])
  @@index([courseTypeId])
  @@map("chapters")
}

enum LessonType {
  video
  text
  quiz
}

model Lesson {
  id                Int          @id @default(autoincrement())
  chapterId         Int
  title             String
  description       String?
  type              LessonType
  videoUrl          String?
  videoPublicId     String?
  thumbnailUrl      String?
  thumbnailPublicId String?
  noteUrl           String?
  notePublicId      String?
  noteFileType      String?
  content           String?
  displayOrder      Int          @default(0)
  isFreePreview     Boolean      @default(false)
  accessType        AccessType   @default(free)
  status            CourseStatus @default(draft)
  // A quiz-type lesson points at a Quiz instead of stuffing a ref into
  // `content`. Unique: a quiz is served by at most one lesson.
  quizId            Int?         @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id])
  quiz    Quiz?   @relation(fields: [quizId], references: [id])

  // A premium lesson can be unlocked by any number of plans. No rows means
  // "any active subscription for the course" — the old planId = null case.
  lessonPlans LessonPlan[]
  savedBy     SavedLesson[]
  progress    LessonProgress[]

  @@index([chapterId, displayOrder])
  @@map("lessons")
}

// Which plans unlock which lessons. Explicit join so both sides can be
// queried and so deleting either end just drops the link.
model LessonPlan {
  lessonId Int
  planId   Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([lessonId, planId])
  @@index([planId])
  @@map("lesson_plans")
}

model Plan {
  id           Int      @id @default(autoincrement())
  courseId     Int
  title        String // e.g. "3-month access"
  description  String?
  price        Float // e.g. 199.00
  durationDays Int // e.g. 90
  isActive     Boolean  @default(true) // admin can disable a plan without deleting it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  lessonPlans   LessonPlan[]

  @@index([courseId])
  @@map("plans")
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  planId    Int
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@map("subscriptions")
}

// ─────────────────────────── Question Bank ───────────────────────────

enum Difficulty {
  easy
  medium
  hard
}

enum QuestionStatus {
  active
  inactive
}

model Question {
  id               Int            @id @default(autoincrement())
  subjectId        Int
  topicId          Int
  questionText     String
  questionImageUrl String?
  difficulty       Difficulty
  marksCorrect     Float
  marksIncorrect   Float          @default(0)
  explanation      String?
  status           QuestionStatus @default(active)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
  topic   Topic   @relation(fields: [topicId], references: [id])

  options QuestionOption[]
  tags    QuestionTag[]

  // Quizzes that pinned this question explicitly. Filter-based quizzes do not
  // appear here — they match on subject/topic/tag at serve time.
  quizQuestions QuizQuestion[]
  savedBy       SavedQuestion[]

  @@index([subjectId, topicId, status])
  @@map("questions")
}

model QuestionOption {
  id             Int     @id @default(autoincrement())
  questionId     Int
  optionText     String
  optionImageUrl String?
  isCorrect      Boolean @default(false)
  displayOrder   Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

// A quiz is a saved *filter* over the question bank, not a copy of questions.
// It never writes to Question — the pool is resolved at serve time, so
// questions added to the bank later show up automatically.
model Quiz {
  id            Int            @id @default(autoincrement())
  title         String
  subjectId     Int
  topicId       Int
  // Matches a Tag name already used on questions ("dha", "mohap"). Null =
  // don't filter by tag.
  examTag       String?
  // How many questions to serve. Null = serve the whole matching pool.
  questionCount Int?
  status        QuestionStatus @default(active)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
  topic   Topic   @relation(fields: [topicId], references: [id])
  lesson  Lesson?

  // Hand-picked questions. When this is empty the quiz falls back to the
  // subject+topic+examTag filter above, which is how every quiz built from the
  // spreadsheet works. Any rows here mean the admin chose exactly these, in
  // this order, and the filter is ignored.
  quizQuestions QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([subjectId, topicId, status])
  @@map("quizzes")
}

// Join row for a hand-authored quiz. Both sides cascade: deleting the quiz
// drops its picks, and deleting a question removes it from every quiz that
// pinned it rather than leaving a dangling reference.
model QuizQuestion {
  quizId       Int
  questionId   Int
  displayOrder Int @default(0)

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizId, questionId])
  @@index([questionId])
  @@map("quiz_questions")
}

model Tag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  questions QuestionTag[]

  @@map("tags")
}

model QuestionTag {
  questionId Int
  tagId      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
  @@map("question_tags")
}

// One student's run at one quiz. Created when they open it, closed when they
// finish, and answered one question at a time in between.
//
// questionIds freezes the set that was served. A filter quiz samples randomly,
// so without this the server could not tell later which questions this student
// actually saw — the review screen would be scored against a different draw.
model QuizAttempt {
  id          Int       @id @default(autoincrement())
  userId      Int
  quizId      Int
  lessonId    Int
  questionIds Int[]
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  // "This student's attempts at this lesson, newest first" is every history
  // and resume query the app makes.
  @@index([userId, lessonId, startedAt])
  @@map("quiz_attempts")
}

// One answered question. Skipped questions have no row at all — absence is
// what "skipped" means, which keeps re-answering a simple upsert.
//
// isCorrect and marksAwarded are stored rather than recomputed: an admin can
// edit a question's options after the fact, and a past attempt must keep the
// result the student actually got.
model AttemptAnswer {
  attemptId        Int
  questionId       Int
  selectedOptionId Int
  isCorrect        Boolean
  marksAwarded     Float
  answeredAt       DateTime @default(now())

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, questionId])
  @@map("attempt_answers")
}

// A student's bookmarked question. The pair is the identity, so saving twice is
// an upsert rather than a duplicate.
model SavedQuestion {
  userId     Int
  questionId Int
  savedAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, savedAt])
  @@map("saved_questions")
}

// Same idea for a lesson. Separate table rather than a polymorphic one so both
// foreign keys stay real and a deleted lesson takes its bookmarks with it.
model SavedLesson {
  userId   Int
  lessonId Int
  savedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId, savedAt])
  @@map("saved_lessons")
}

// How far a student got in one lesson. Without this the home screen cannot say
// "12 of 40 videos", which is the whole point of a module card.
//
// completed is stored rather than derived from lastPositionSeconds: a student
// who scrubs to the end has not watched it, and one who stops at 95% has. Only
// the client knows which, so it says so explicitly.
model LessonProgress {
  userId              Int
  lessonId            Int
  completed           Boolean  @default(false)
  lastPositionSeconds Int      @default(0)
  updatedAt           DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  // "what did this student touch last" drives Continue Watching.
  @@index([userId, updatedAt])
  @@map("lesson_progress")
}
