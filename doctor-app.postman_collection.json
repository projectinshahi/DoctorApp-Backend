    {
      "name": "2. Questions",
      "item": [
        {
          "name": "List ALL questions (no filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/questions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions"
              ]
            }
          }
        },
        {
          "name": "List questions (filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/questions?subjectId={{subjectId}}&topicId={{topicId}}&tag=dha&difficulty=medium&status=active&sort=newest&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions"
              ],
              "query": [
                {
                  "key": "subjectId",
                  "value": "{{subjectId}}"
                },
                {
                  "key": "topicId",
                  "value": "{{topicId}}"
                },
                {
                  "key": "tag",
                  "value": "dha",
                  "description": "exam board: dha/doh/mohap/sha/kuwait/smle/omsb/qchp/nhra"
                },
                {
                  "key": "difficulty",
                  "value": "medium",
                  "description": "easy | medium | hard"
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "active | inactive"
                },
                {
                  "key": "search",
                  "value": "chest",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "newest",
                  "description": "newest|oldest|difficulty_asc|difficulty_desc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "max 100"
                }
              ]
            }
          }
        },
        {
          "name": "Get one question",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions",
                "{{questionId}}"
              ]
            }
          }
        },
        {
          "name": "Create question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('questionId', pm.response.json().question.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectId\": {{subjectId}},\n  \"topicId\": {{topicId}},\n  \"questionText\": \"Which drug class is first-line for reducing mortality in HFrEF?\",\n  \"questionImageUrl\": null,\n  \"difficulty\": \"medium\",\n  \"marksCorrect\": 2,\n  \"marksIncorrect\": -0.5,\n  \"explanation\": \"ACE inhibitors/ARBs reduce mortality in HFrEF.\",\n  \"status\": \"active\",\n  \"tags\": [\"cardiology\", \"heart-failure\", \"dha\", \"mohap\"],\n  \"options\": [\n    { \"optionText\": \"ACE inhibitors\", \"isCorrect\": true },\n    { \"optionText\": \"Calcium channel blockers\", \"isCorrect\": false },\n    { \"optionText\": \"Loop diuretics\", \"isCorrect\": false },\n    { \"optionText\": \"Digoxin\", \"isCorrect\": false }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/questions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions"
              ]
            }
          }
        },
        {
          "name": "Update question (full replace of options/tags)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"Updated question text\",\n  \"difficulty\": \"hard\",\n  \"tags\": [\"cardiology\", \"dha\"],\n  \"options\": [\n    { \"optionText\": \"Correct answer\", \"isCorrect\": true },\n    { \"optionText\": \"Wrong answer\", \"isCorrect\": false }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions",
                "{{questionId}}"
              ]
            }
          }
        },
        {
          "name": "Deactivate question (use instead of delete)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions",
                "{{questionId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Bulk activate / deactivate",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionIds\": [1],\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/questions/bulk-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions",
                "bulk-status"
              ]
            }
          }
        },
        {
          "name": "Duplicate question (copy is created inactive)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}/duplicate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions",
                "{{questionId}}",
                "duplicate"
              ]
            }
          }
        },
        {
          "name": "Delete question (200 \u2014 pools shrink, nothing dangles)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "questions",
                "{{questionId}}"
              ]
            },
            "description": "Returns 200 with { message, questionId, affectedQuizzes }.\n\nIt used to 409 on the assumption that quizzes hold references to question rows. They hold a filter (subject + topic + optional exam tag) resolved at serve time, so deleting cannot dangle anything \u2014 the matching quiz pools just shrink by one. affectedQuizzes tells you how many shrank.\n\nPrefer PATCH /status -> inactive when you may want the question back: delete cascades its options and tags and is not recoverable."
          }
        }
      ]
    },
