{
  "info": {
    "name": "Doctor App \u2014 Question Bank & Quiz",
    "description": "Admin flows for the question bank, quizzes and lesson linking.\n\nSETUP:\n1. Pick the environment variable baseUrl (defaults to http://localhost:3000).\n2. Run 'Admin login' FIRST \u2014 it saves the token automatically, every other request inherits it.\n\nAll requests except login require an admin token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "subjectId",
      "value": "7"
    },
    {
      "key": "topicId",
      "value": "1"
    },
    {
      "key": "questionId",
      "value": "1"
    },
    {
      "key": "quizId",
      "value": "12"
    },
    {
      "key": "lessonId",
      "value": "26"
    },
    {
      "key": "chapterId",
      "value": "14"
    },
    {
      "key": "courseTypeId",
      "value": "15"
    },
    {
      "key": "studentToken",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjI4LCJyb2xlIjoic3R1ZGVudCIsInNlc3Npb25JZCI6NTEsImlhdCI6MTc4NzU0NDczOCwiZXhwIjoxNzg3NTY2MzM4fQ.uIaqGGuEIOhcA2iEXKvM5GI8dK3Y2E8AOkrCo39yDbY",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Admin login (run this first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Token saved. Expires in 8h.');",
                  "} else {",
                  "  console.log('No token in response:', JSON.stringify(res));",
                  "}",
                  "pm.test('login returns 200 + token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res).to.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@yourapp.com\",\n  \"password\": \"REPLACE_WITH_YOUR_PASSWORD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "admin",
                "login"
              ]
            }
          }
        }
      ]
    },
