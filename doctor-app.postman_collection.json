    {
      "name": "6. Student quiz flow (verified live)",
      "description": "Set {{studentToken}} first. A student token is NOT email/password \u2014 login is Google-only (POST /api/auth/google with a real Google idToken + deviceId), and the token must carry a sessionId matching a live row in the sessions table. Easiest path: sign in on the Flutter app and copy its access token.\n\nEvery response documented below was captured from the live backend.",
      "item": [
        {
          "name": "1. Who am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Confirms the student token works. 200 = good."
          },
          "response": []
        },
        {
          "name": "2. My selected course",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/selection",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "selection"
              ]
            },
            "description": "A student with no selection gets null here, and every quiz call below returns 409."
          },
          "response": []
        },
        {
          "name": "3. My course content (find quiz lessons)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/selection/content",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "selection",
                "content"
